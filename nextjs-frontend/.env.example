# Copy to .env.local (development) or provide as environment variables.

# Express API origin, used server-side only (BFF /bff/*, /api/panel/session, route guard)
NEAT_API_ORIGIN=http://localhost:4000

# Same value as the API's JWT_SECRET. Lets the route guard verify the token
# signature; without it only the expiry is checked (the API still verifies).
NEAT_JWT_SECRET=
NEAT_JWT_TTL=60

# Public origin serving /files/... and /upload/... (inlined at build time)
NEXT_PUBLIC_FILES_ORIGIN=http://localhost:4000
# Base URL shown in reproduced HttpErrorResponse texts (defaults to NEXT_PUBLIC_FILES_ORIGIN/api)
NEXT_PUBLIC_API_DISPLAY_BASE=
