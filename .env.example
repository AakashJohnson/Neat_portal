# Copy to .env and configure local database and service credentials.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000/api
APP_TIMEZONE=UTC

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=neat_portal_test
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=

JWT_SECRET=
JWT_TTL=60

CORS_ORIGINS=http://localhost:3000

# smtp = send real mail, json = capture only (tests/dev)
MAIL_TRANSPORT=json
# SendGrid uses MAIL_HOST=smtp.sendgrid.net, MAIL_USERNAME=apikey and the API key as MAIL_PASSWORD.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Uploads and assets, relative to the backend root (absolute paths also supported).
PUBLIC_STORAGE_PATH=storage/public
# Writable admin settings; safe defaults are created on first startup if absent.
SETTINGS_PATH=storage/settings.json

# Express 'trust proxy' for the client IP (rate limits, activity log): loopback when Next.js
# runs on the same host; behind nginx/a load balancer use the hop count or the proxy subnets
TRUST_PROXY=loopback

# Database pool and token lifetimes (minutes)
DB_POOL_MAX=10
JWT_REFRESH_TTL=20160
# Window for active sessions in me/sessions and users/{id}/sessions
SESSION_LIFETIME=120

# Public URLs used in e-mails: the portal (reset/verify links) and the Next.js panel (/panel)
FRONTEND_URL=http://localhost:3000
PANEL_URL=http://localhost:3000/panel

# NEAT Phase-2 EoI system: MoU forwarding API and the cross-database schemas on the same MySQL server
EOI_API_URL=https://neatphase2eoiapi.aicte-india.org/api/saveDocument
EOI_DB_SCHEMA=neatphase2eoi
EOI_REGISTRY_DB_SCHEMA=neatphase2

# Optional integrations (BLOCKED until provided): Authy 2FA and Google reCAPTCHA
AUTHY_KEY=
RECAPTCHA_SITEKEY=
RECAPTCHA_SECRETKEY=
