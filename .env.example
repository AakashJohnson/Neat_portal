# Copy to .env and fill in. Key names mirror the Laravel backend .env.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000/api
APP_TIMEZONE=UTC

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=neat_portal_test
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=

JWT_SECRET=
JWT_TTL=60

CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# smtp = send real mail, json = capture only (tests/dev)
MAIL_TRANSPORT=json
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Laravel public/ directory that holds files/ and upload/ (shared during transition)
PUBLIC_STORAGE_PATH=../../NEAT portal old/backend/backend/public
# Copy of the Laravel storage/settings.json (the panel settings pages write to it)
SETTINGS_PATH=storage/settings.json

# Database pool and token lifetimes (minutes)
DB_POOL_MAX=10
JWT_REFRESH_TTL=20160
# Laravel SESSION_LIFETIME: window for "active" sessions in me/sessions and users/{id}/sessions
SESSION_LIFETIME=120

# Public URLs used in e-mails: the portal (reset/verify links) and the Next.js panel (/panel)
FRONTEND_URL=https://neat.aicte-india.org
PANEL_URL=http://localhost:3000/panel

# NEAT Phase-2 EoI system: MoU forwarding API and the cross-database schemas on the same MySQL server
EOI_API_URL=https://neatphase2eoiapi.aicte-india.org/api/saveDocument
EOI_DB_SCHEMA=neatphase2eoi
EOI_REGISTRY_DB_SCHEMA=neatphase2

# true re-opens the original unauthenticated upload/delete/MoU endpoints (contract comparison only; never in production)
LEGACY_PUBLIC_ENDPOINTS=false

# Optional integrations (BLOCKED until provided): Authy 2FA and Google reCAPTCHA
AUTHY_KEY=
RECAPTCHA_SITEKEY=
RECAPTCHA_SECRETKEY=

# Test-only (contract tests against neat_portal_test)
FIXTURE_PASSWORD=
FIXTURE_USERS=admin:1,student:13,company:39,institute:56,learner:72
LARAVEL_REFERENCE_URL=http://127.0.0.1:8001
