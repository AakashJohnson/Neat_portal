# Copy to .env and fill in. Key names mirror the Laravel backend .env.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000/api
APP_TIMEZONE=UTC

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=neat_portal_test
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=

JWT_SECRET=
JWT_TTL=60

CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# smtp = send real mail, json = capture only (tests/dev)
MAIL_TRANSPORT=json
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Laravel public/ directory that holds files/ and upload/ (shared during transition)
PUBLIC_STORAGE_PATH=../../NEAT portal old/backend/backend/public
SETTINGS_PATH=../../NEAT portal old/backend/backend/storage/settings.json

# Test-only (contract tests against neat_portal_test)
FIXTURE_PASSWORD=
FIXTURE_USERS=admin:1,student:13,company:39,institute:56,learner:72
LARAVEL_REFERENCE_URL=http://127.0.0.1:8001
