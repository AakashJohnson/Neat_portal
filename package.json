{
  "name": "neat-express-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NEAT portal API — Node.js + Express.js (plain JavaScript) port of the Laravel backend. Uses the existing MySQL schema unchanged.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:baseline": "node scripts/schema-baseline.js",
    "check:no-ts": "node scripts/check-no-ts.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "juice": "^12.2.0",
    "knex": "^3.3.0",
    "marked": "^18.1.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
